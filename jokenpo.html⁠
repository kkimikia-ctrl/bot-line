<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Jokenpô Brasil</title>
    <!-- Importando o Firebase SDK (Compat) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
    <style>
        body { font-family: sans-serif; background-color: #f4f6f9; margin: 0; padding: 10px; text-align: center; }
        .container { max-width: 600px; margin: 0 auto; }
        .card-game { background: white; padding: 15px; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .botoes-brasil { background: #fedf00; border: 2px solid #009b3a; border-radius: 10px; padding: 8px; display: flex; justify-content: center; gap: 10px; margin-top: 10px; }
        .btn-jogada-br { font-size: 26px; padding: 8px 12px; border-radius: 8px; border: 2px solid #002776; background: white; cursor: pointer; }
        .painel-info { display: flex; justify-content: space-around; background: #e0f2fe; padding: 8px; border-radius: 8px; font-weight: bold; margin-bottom: 10px; font-size: 14px; color: #0369a1; }
        .action-btn { background-color: #2563eb; color: white; border: none; width: 100%; padding: 12px; border-radius: 10px; font-size: 14px; font-weight: bold; cursor: pointer; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card-game">
            <button onclick="window.location.href='index.html'" style="background: #ccc; border: none; padding: 6px 12px; border-radius: 4px; margin-bottom: 10px; cursor: pointer; float: left; font-weight: bold;">⬅ Voltar ao Menu</button>
            <div style="clear: both;"></div>
            <h3>🇧🇷 Jokenpô Brasil 🇦🇷</h3>

            <div class="painel-info">
                <div>❤️ Vidas: <span id="txt-vidas">2</span></div>
                <div>🏆 Pontos: <span id="txt-pontos">0</span></div>
            </div>

            <div style="margin: 15px auto; width: 65px; height: 65px; line-height: 65px; font-size: 30px; background: #e8f0fe; border: 2px dashed #002776; border-radius: 50%;">
                <span id="pc">❓</span>
            </div>
            <p id="res" style="font-weight: bold;"></p>
            <div class="botoes-brasil" id="area-botoes">
                <button onclick="jogar('pedra')" class="btn-jogada-br">✊</button>
                <button onclick="jogar('papel')" class="btn-jogada-br">✋</button>
                <button onclick="jogar('tesoura')" class="btn-jogada-br">✌️</button>
            </div>

            <!-- Botões de Controle e Salvar -->
            <button onclick="salvarPontuacaoFirebase()" id="btn-salvar-manual" class="action-btn" style="background-color: #0284c7; display: none;">💾 Salvar Pontos</button>
            <button onclick="reiniciarTudo()" id="btn-reiniciar" class="action-btn" style="background-color: #dc2626; display: none;">Jogar Novamente</button>
        </div>
    </div>
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyCTQTWEyj8f-Ddkj6PD9Fe8JHCVVjmkS_o",
            authDomain: "ajuda-jp.firebaseapp.com",
            projectId: "ajuda-jp",
            storageBucket: "ajuda-jp.firebasestorage.app",
            messagingSenderId: "40121072206",
            appId: "1:40121072206:web:8a844e632f004f61d0a11f"
        };
        
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const db = firebase.firestore();

        let vidas = 2;
        let pontos = 0;
        let jogoAtivo = true;

        function jogar(usuario) {
            if (!jogoAtivo) return;

            const ops = ['pedra', 'papel', 'tesoura'], ems = {pedra:'✊', papel:'✋', tesoura:'✌️'};
            const maquina = ops[Math.floor(Math.random()*3)];
            document.getElementById('pc').innerText = ems[maquina];
            let r = "";

            if (usuario === maquina) {
                r = "Empate!";
            } else if ((usuario === 'pedra' && maquina === 'tesoura') || (usuario === 'papel' && maquina === 'pedra') || (usuario === 'tesoura' && maquina === 'papel')) {
                r = "🎉 Brasil Venceu!";
                pontos += 10;
            } else {
                r = "❌ Brasil Perdeu!";
                vidas--;
            }

            document.getElementById('txt-vidas').innerText = vidas;
            document.getElementById('txt-pontos').innerText = pontos;
            document.getElementById('res').innerText = r;

            if (pontos > 0) {
                document.getElementById('btn-salvar-manual').style.display = 'block';
            }

            if (vidas <= 0) {
                jogoAtivo = false;
                document.getElementById('res').innerText = "💀 Game Over! Fim de Vidas.";
                document.getElementById('area-botoes').style.display = 'none';
                document.getElementById('btn-salvar-manual').style.display = 'none';
                document.getElementById('btn-reiniciar').style.display = 'block';
            }
        }

        function reiniciarTudo() {
            vidas = 2;
            pontos = 0;
            jogoAtivo = true;
            document.getElementById('txt-vidas').innerText = vidas;
            document.getElementById('txt-pontos').innerText = pontos;
            document.getElementById('res').innerText = '';
            document.getElementById('pc').innerText = '❓';
            document.getElementById('area-botoes').style.display = 'flex';
            document.getElementById('btn-salvar-manual').style.display = 'none';
            document.getElementById('btn-reiniciar').style.display = 'none';
        }

        async function salvarPontuacaoFirebase() {
            if (pontos <= 0) {
                alert("Você precisa fazer alguns pontos antes de salvar!");
                return;
            }

            let nomeSalvo = localStorage.getItem('nomeJogadorCentral') || "Jogador";
            let nomeJogador = prompt("🏆 Digite seu nome para o Ranking Global:", nomeSalvo);
            
            if (!nomeJogador || nomeJogador.trim() === "") return;
            
            nomeJogador = nomeJogador.trim();
            localStorage.setItem('nomeJogadorCentral', nomeJogador);

            try {
                const colecaoRef = db.collection("ranking_jokenpo");

                const querySnapshot = await colecaoRef.orderBy("pontos", "desc").limit(100).get();
                
                let pontuacoesTop = [];
                querySnapshot.forEach((docSnap) => {
                    pontuacoesTop.push(docSnap.data().pontos);
                });

                if (pontuacoesTop.length >= 100) {
                    const menorPontuacaoTop100 = pontuacoesTop[pontuacoesTop.length - 1];
                    
                    if (pontos <= menorPontuacaoTop100) {
                        alert(`Sua pontuação (${pontos}) não atingiu o mínimo necessário para entrar no Top 100 (mínimo atual: ${menorPontuacaoTop100} pts). Tente novamente!`);
                        return;
                    }
                }

                const idUnicoDoc = `${nomeJogador}_${Date.now()}`;
                await colecaoRef.doc(idUnicoDoc).set({
                    nome: nomeJogador,
                    pontos: Number(pontos),
                    data: new Date().toISOString()
                });
                
                localStorage.setItem('ultimoJogoRetorno', 'jokenpo.html');

                alert("✅ Parabéns! Sua pontuação entrou para o Top 100 Global!");
                window.location.href = "ranking.html";
            } catch (error) {
                console.error("Erro ao salvar no Firebase:", error);
                alert("❌ Erro ao salvar pontuação online.");
            }
        }
    </script>
</body>
</html>
