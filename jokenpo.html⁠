<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Jokenpô Brasil</title>
    <style>
        body { font-family: sans-serif; background-color: #f4f6f9; margin: 0; padding: 10px; text-align: center; }
        .container { max-width: 600px; margin: 0 auto; }
        .card-game { background: white; padding: 15px; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .botoes-brasil { background: #fedf00; border: 2px solid #009b3a; border-radius: 10px; padding: 8px; display: flex; justify-content: center; gap: 10px; margin-top: 10px; }
        .btn-jogada-br { font-size: 26px; padding: 8px 12px; border-radius: 8px; border: 2px solid #002776; background: white; cursor: pointer; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card-game">
            <button onclick="window.location.href='index.html'" style="background: #ccc; border: none; padding: 6px 12px; border-radius: 4px; margin-bottom: 10px; cursor: pointer; float: left; font-weight: bold;">⬅ Voltar ao Menu</button>
            <div style="clear: both;"></div>
            <h3>🇧🇷 Jokenpô Brasil 🇦🇷</h3>
            <div style="margin: 15px auto; width: 65px; height: 65px; line-height: 65px; font-size: 30px; background: #e8f0fe; border: 2px dashed #002776; border-radius: 50%;">
                <span id="pc">❓</span>
            </div>
            <p id="res" style="font-weight: bold;"></p>
            <div class="botoes-brasil">
                <button onclick="jogar('pedra')" class="btn-jogada-br">✊</button>
                <button onclick="jogar('papel')" class="btn-jogada-br">✋</button>
                <button onclick="jogar('tesoura')" class="btn-jogada-br">✌️</button>
            </div>
        </div>
    </div>
    <script>
        function jogar(usuario) {
            const ops = ['pedra', 'papel', 'tesoura'], ems = {pedra:'✊', papel:'✋', tesoura:'✌️'};
            const maquina = ops[Math.floor(Math.random()*3)];
            document.getElementById('pc').innerText = ems[maquina];
            let r = "";
            if (usuario === maquina) r = "Empate!";
            else if ((usuario === 'pedra' && maquina === 'tesoura') || (usuario === 'papel' && maquina === 'pedra') || (usuario === 'tesoura' && maquina === 'papel')) r = "🎉 Brasil Venceu!";
            else r = "❌ Brasil Perdeu!";
            document.getElementById('res').innerText = r;
        }
    </script>
</body>
</html>
